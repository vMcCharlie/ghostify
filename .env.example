# Deployed Announcer.sol address. Leave blank to use demo mode in the UI.
NEXT_PUBLIC_ANNOUNCER_ADDRESS=
# Deployed MetaAddressRegistry.sol address. Enables wallet-address lookup.
NEXT_PUBLIC_REGISTRY_ADDRESS=
# Optional: public RPC override. Defaults to https://testnet-rpc.monad.xyz
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
